# Playwright/browser-export JSON, for example:
# REDDIT_COOKIES='[{"name":"reddit_session","value":"replace-me"}]'
REDDIT_COOKIES=

# Optional for local report generation when Copilot CLI is not already authenticated.
# In GitHub Actions, store this token in the COPILOT_PAT repository secret instead.
COPILOT_GITHUB_TOKEN=

# Required only when running `refresh-cookies` locally. Use a token that may
# update Actions secrets and create issues in this repository.
GH_TOKEN=
GITHUB_REPOSITORY=owner/repository
