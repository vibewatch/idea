---
import type { Locale } from '../lib/i18n';
import { localeFromPath, useStrings } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const strings = useStrings(locale).theme;
---

<button
  class="icon-button theme-toggle"
  type="button"
  aria-label={strings.toDark}
  title={strings.toDark}
  data-theme-toggle
  data-label-light={strings.toLight}
  data-label-dark={strings.toDark}
>
  <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
  </svg>
  <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"></path>
  </svg>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function currentTheme(): 'light' | 'dark' {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function updateLabel() {
    if (!toggle) return;
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    const label = next === 'dark' ? toggle.dataset.labelDark : toggle.dataset.labelLight;
    if (!label) return;
    toggle.setAttribute('aria-label', label);
    toggle.setAttribute('title', label);
  }

  toggle?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('idea-theme', next);
    updateLabel();
  });

  updateLabel();
</script>