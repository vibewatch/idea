---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const sections = Astro.props.headings.filter(({ depth }) => depth === 2);
---

{sections.length > 0 && (
  <nav class="report-toc" aria-label="Report contents">
    <p class="toc-label">Contents</p>
    <ol>
      {sections.map((heading) => (
        <li>
          <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
            {heading.text.replace(/^\d+\.\s*/, '')}
          </a>
        </li>
      ))}
    </ol>
    <a class="toc-back" href="#report-top">Back to top</a>
  </nav>
)}

<script>
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const headings = tocLinks
    .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  if (headings.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top)[0];
        if (!visible) return;
        tocLinks.forEach((link) => {
          link.toggleAttribute('aria-current', link.dataset.tocLink === visible.target.id);
        });
      },
      { rootMargin: '-15% 0px -75% 0px' },
    );
    headings.forEach((heading) => observer.observe(heading));
  }
</script>
