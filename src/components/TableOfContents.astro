---
import type { Locale } from '../lib/i18n';
import { useStrings } from '../lib/i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const strings = useStrings(locale).report;
const sections = Astro.props.headings.filter(({ depth }) => depth === 2);
---

{sections.length > 0 && (
  <div class="toc-dock" data-toc-dock>
    <details>
      <summary class="toc-fab" aria-label={strings.contents} title={strings.contents}>
        <svg class="toc-icon--open" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h10M4 12h16M4 18h7"></path>
        </svg>
        <svg class="toc-icon--close" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </summary>
      <nav class="toc-panel" aria-label={strings.contents}>
        <p class="toc-label">{strings.contents}</p>
        <ol>
          {sections.map((heading, index) => (
            <li>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                <em aria-hidden="true">{String(index + 1).padStart(2, '0')}</em>
                <span>{heading.text.replace(/^\d+\.\s*/, '')}</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="toc-back" href="#report-top">{strings.backToTop}</a>
      </nav>
    </details>
  </div>
)}

<script>
  const dock = document.querySelector<HTMLElement>('[data-toc-dock]');
  const details = dock?.querySelector('details');
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];

  const close = () => details?.removeAttribute('open');

  dock?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
  });

  document.addEventListener('click', (event) => {
    if (details?.open && !dock?.contains(event.target as Node)) close();
  });

  const headings = tocLinks
    .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  if (headings.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top)[0];
        if (!visible) return;
        tocLinks.forEach((link) => {
          link.toggleAttribute('aria-current', link.dataset.tocLink === visible.target.id);
        });
      },
      { rootMargin: '-15% 0px -75% 0px' },
    );
    headings.forEach((heading) => observer.observe(heading));
  }
</script>
