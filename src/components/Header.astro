---
import { withBase } from '../lib/paths';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const links = [
  { href: withBase('/reports/'), label: 'Reports' },
  { href: withBase('/about/'), label: 'Method' },
];

const isActive = (href: string) => pathname.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')} aria-label="Idea home">
      <span class="brand-mark" aria-hidden="true">Id</span>
      <span class="brand-text">Idea<small>Signal Desk</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="search-trigger" type="button" data-search-open aria-label="Search reports">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span>Search</span>
        <kbd aria-hidden="true" data-search-shortcut>Ctrl K</kbd>
      </button>
      <ThemeToggle />
      <details class="mobile-menu">
        <summary class="icon-button" aria-label="Open navigation">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav aria-label="Mobile navigation">
          {links.map((link) => (
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
          <button type="button" data-search-open>Search</button>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  const syncScrollState = () => {
    header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  };

  syncScrollState();
  window.addEventListener('scroll', syncScrollState, { passive: true });

  if (/Mac|iPhone|iPad/i.test(navigator.userAgent)) {
    const shortcut = document.querySelector<HTMLElement>('[data-search-shortcut]');
    if (shortcut) shortcut.textContent = '⌘ K';
  }
</script>
