---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import type { Locale } from '../lib/i18n';
import { localePath, useStrings } from '../lib/i18n';

interface Props {
  locale: Locale;
  alternateHref: string;
}

const { locale, alternateHref } = Astro.props;
const strings = useStrings(locale);
const pathname = Astro.url.pathname;
const links = [
  { href: localePath(locale, '/reports/'), label: strings.nav.reports },
  { href: localePath(locale, '/about/'), label: strings.nav.method },
];

const isActive = (href: string) => pathname.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand" href={localePath(locale, '/')} aria-label={strings.siteName}>
      <span class="brand-mark" aria-hidden="true">Id</span>
      <span class="brand-text">Idea<small>{strings.siteTagline}</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="search-trigger" type="button" data-search-open aria-label={strings.search.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span>{strings.search.trigger}</span>
        <kbd aria-hidden="true" data-search-shortcut>Ctrl K</kbd>
      </button>
      <LanguageToggle locale={locale} href={alternateHref} />
      <ThemeToggle locale={locale} />
      <details class="mobile-menu">
        <summary class="icon-button" aria-label="Open navigation">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav aria-label="Mobile navigation">
          {links.map((link) => (
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
          <button type="button" data-search-open>{strings.search.trigger}</button>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  const syncScrollState = () => {
    header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  };

  syncScrollState();
  window.addEventListener('scroll', syncScrollState, { passive: true });

  if (/Mac|iPhone|iPad/i.test(navigator.userAgent)) {
    const shortcut = document.querySelector<HTMLElement>('[data-search-shortcut]');
    if (shortcut) shortcut.textContent = '⌘ K';
  }
</script>
