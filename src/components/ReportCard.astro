---
import type { ReportMeta } from '../lib/reports';
import { withBase } from '../lib/paths';

interface Props {
  meta: ReportMeta;
}

const { meta } = Astro.props;
const reportUrl = withBase(`/reports/${meta.date}/`);
---

<article
  class="report-card"
  data-report-card
  data-year={meta.year}
  data-search={`${meta.title} ${meta.description} ${meta.signals.flatMap(({ items }) => items).join(' ')}`.toLowerCase()}
>
  <div class="report-card__meta">
    <time datetime={meta.date}>{meta.displayDate}</time>
    <span>{meta.readingMinutes} min read</span>
  </div>
  <h2><a href={reportUrl}>{meta.title}</a></h2>
  <p>{meta.description}</p>
  <a class="report-card__link" href={reportUrl} aria-label={`Read ${meta.title}`}>Read report</a>
</article>
