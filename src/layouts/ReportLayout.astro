---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { ReportMeta } from '../lib/reports';
import type { Locale } from '../lib/i18n';
import { localePath, useStrings } from '../lib/i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Neighbor {
  date: string;
  title: string;
}

interface Props {
  meta: ReportMeta;
  headings: Heading[];
  older?: Neighbor | undefined;
  newer?: Neighbor | undefined;
  locale?: Locale;
  alternateHref?: string | undefined;
}

const { meta, headings, older, newer, locale = 'en' } = Astro.props;
const strings = useStrings(locale);
const copy = strings.report;
// Fall back to the archive so the language switch never lands on a missing overlay.
const alternateHref =
  Astro.props.alternateHref ?? localePath(locale === 'zh' ? 'en' : 'zh', '/reports/');
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  locale={locale}
  alternateHref={alternateHref}
  type="article"
  publishedTime={`${meta.date}T00:00:00Z`}
>
  <article class="report-page" id="report-top" data-pagefind-filter={`year:${meta.year}`}>
    <header class="report-hero shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={localePath(locale, '/')}>{copy.home}</a>
        <span aria-hidden="true">/</span>
        <a href={localePath(locale, '/reports/')}>{copy.reports}</a>
        <span aria-hidden="true">/</span>
        <span>{meta.date}</span>
      </nav>
      <h1 data-pagefind-meta="title">{meta.title}</h1>
      <p class="report-deck">{meta.description}</p>
      <ul class="report-facts">
        <li>
          <span>{copy.published}</span>
          <strong><time datetime={meta.date} data-pagefind-meta="date">{meta.displayDate}</time></strong>
        </li>
        <li>
          <span>{copy.reading}</span>
          <strong>{meta.readingMinutes} {copy.minutes}</strong>
        </li>
        <li>
          <span>{copy.sections}</span>
          <strong>{meta.sectionCount}</strong>
        </li>
        <li>
          <span>{copy.sources}</span>
          <strong>{meta.citationCount}</strong>
        </li>
        {meta.postCount !== null && (
          <li>
            <span>{copy.posts}</span>
            <strong>{meta.postCount.toLocaleString(locale === 'zh' ? 'zh-CN' : 'en-US')}</strong>
          </li>
        )}
      </ul>
    </header>

    <div class="report-body shell">
      <div class="report-main">
        <div class="report-prose" data-report-content>
          <slot />
        </div>
        {(older || newer) && (
          <nav class="report-neighbors" aria-label="Adjacent reports">
            {older ? (
              <a href={localePath(locale, `/reports/${older.date}/`)} rel="prev">
                <span>{copy.older}</span>
                <strong>{older.title}</strong>
              </a>
            ) : <span></span>}
            {newer && (
              <a href={localePath(locale, `/reports/${newer.date}/`)} rel="next">
                <span>{copy.newer}</span>
                <strong>{newer.title}</strong>
              </a>
            )}
          </nav>
        )}
      </div>
    </div>

    <TableOfContents headings={headings} locale={locale} />
  </article>
</BaseLayout>
