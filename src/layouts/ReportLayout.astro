---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { ReportMeta } from '../lib/reports';
import { withBase } from '../lib/paths';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Neighbor {
  date: string;
  title: string;
}

interface Props {
  meta: ReportMeta;
  headings: Heading[];
  older?: Neighbor | undefined;
  newer?: Neighbor | undefined;
}

const { meta, headings, older, newer } = Astro.props;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  type="article"
  publishedTime={`${meta.date}T00:00:00Z`}
>
  <article class="report-page" id="report-top" data-pagefind-filter={`year:${meta.year}`}>
    <header class="report-hero shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/reports/')}>Reports</a>
        <span aria-hidden="true">/</span>
        <span>{meta.date}</span>
      </nav>
      <h1 data-pagefind-meta="title">{meta.title}</h1>
      <p class="report-deck">{meta.description}</p>
      <ul class="report-facts">
        <li>
          <span>Published</span>
          <strong><time datetime={meta.date} data-pagefind-meta="date">{meta.displayDate}</time></strong>
        </li>
        <li>
          <span>Reading time</span>
          <strong>{meta.readingMinutes} min</strong>
        </li>
        <li>
          <span>Sections</span>
          <strong>{meta.sectionCount}</strong>
        </li>
        <li>
          <span>Linked sources</span>
          <strong>{meta.citationCount}</strong>
        </li>
        {meta.postCount !== null && (
          <li>
            <span>Posts reviewed</span>
            <strong>{meta.postCount.toLocaleString('en-US')}</strong>
          </li>
        )}
      </ul>
    </header>

    <div class="report-body shell">
      <div class="report-main">
        <div class="report-prose" data-report-content>
          <slot />
        </div>
        {(older || newer) && (
          <nav class="report-neighbors" aria-label="Adjacent reports">
            {older ? (
              <a href={withBase(`/reports/${older.date}/`)} rel="prev">
                <span>← Older report</span>
                <strong>{older.title}</strong>
              </a>
            ) : <span></span>}
            {newer && (
              <a href={withBase(`/reports/${newer.date}/`)} rel="next">
                <span>Newer report →</span>
                <strong>{newer.title}</strong>
              </a>
            )}
          </nav>
        )}
      </div>
    </div>

    <TableOfContents headings={headings} />
  </article>
</BaseLayout>
