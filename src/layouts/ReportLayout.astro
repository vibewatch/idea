---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { ReportMeta } from '../lib/reports';
import { withBase } from '../lib/paths';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Neighbor {
  date: string;
  title: string;
}

interface Props {
  meta: ReportMeta;
  headings: Heading[];
  older?: Neighbor | undefined;
  newer?: Neighbor | undefined;
}

const { meta, headings, older, newer } = Astro.props;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  type="article"
  publishedTime={`${meta.date}T00:00:00Z`}
>
  <article class="report-page" id="report-top" data-pagefind-filter={`year:${meta.year}`}>
    <header class="report-hero shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/reports/')}>Reports</a>
        <span aria-hidden="true">/</span>
        <span>{meta.date}</span>
      </nav>
      <h1 data-pagefind-meta="title">{meta.title}</h1>
      <p class="report-deck">{meta.description}</p>
      <p class="report-meta">
        <time datetime={meta.date} data-pagefind-meta="date">{meta.displayDate}</time>
        <span aria-hidden="true">·</span>
        <span>{meta.readingMinutes} min read</span>
      </p>
    </header>

    <div class="report-grid shell">
      <aside class="report-sidebar">
        <TableOfContents headings={headings} />
      </aside>
      <div class="report-main">
        <div class="report-prose" data-report-content>
          <slot />
        </div>
        {(older || newer) && (
          <nav class="report-neighbors" aria-label="Adjacent reports">
            {older ? (
              <a href={withBase(`/reports/${older.date}/`)} rel="prev">
                <span>Older report</span>
                <strong>{older.date}</strong>
              </a>
            ) : <span></span>}
            {newer && (
              <a href={withBase(`/reports/${newer.date}/`)} rel="next">
                <span>Newer report</span>
                <strong>{newer.date}</strong>
              </a>
            )}
          </nav>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
