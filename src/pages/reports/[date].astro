---
import { getCollection, render } from 'astro:content';
import ReportLayout from '../../layouts/ReportLayout.astro';
import { getReportMeta, sortReports, type ReportEntry } from '../../lib/reports';
import { localePath } from '../../lib/i18n';

export async function getStaticPaths() {
  const reports = sortReports(await getCollection('reports'));
  const translated = new Set(
    (await getCollection('reportsZh')).map((entry) => getReportMeta(entry).date),
  );
  return reports.map((entry, index) => {
    const meta = getReportMeta(entry);
    const olderEntry = reports[index + 1];
    const newerEntry = reports[index - 1];
    return {
      params: { date: meta.date },
      props: {
        entry,
        older: olderEntry ? getReportMeta(olderEntry) : undefined,
        newer: newerEntry ? getReportMeta(newerEntry) : undefined,
        hasTranslation: translated.has(meta.date),
      },
    };
  });
}

interface Props {
  entry: ReportEntry;
  older?: ReturnType<typeof getReportMeta>;
  newer?: ReturnType<typeof getReportMeta>;
  hasTranslation: boolean;
}

const { entry, older, newer, hasTranslation } = Astro.props;
const meta = getReportMeta(entry);
const { Content, headings } = await render(entry);
---

<ReportLayout
  meta={meta}
  headings={headings}
  older={older}
  newer={newer}
  alternateHref={hasTranslation ? localePath('zh', `/reports/${meta.date}/`) : undefined}
>
  <Content />
</ReportLayout>