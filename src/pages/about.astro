---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

const steps = [
  {
    title: 'Collect',
    text: 'Save daily posts, comments, links, and media references from focused builder communities.',
  },
  {
    title: 'Prepare',
    text: 'Organize sources, remove duplicates, and keep provenance visible.',
  },
  {
    title: 'Extract',
    text: 'Identify concrete projects, problems, ideas, outcomes, and useful visual evidence.',
  },
  {
    title: 'Validate',
    text: 'Check report structure, source links, and media references before publication.',
  },
];

const principles = [
  {
    title: 'Start with specifics',
    text: 'Named projects, direct links, workflows, and metrics come before broad themes.',
  },
  {
    title: 'Keep evidence distinct',
    text: 'A complaint, a product idea, and a paying customer are different kinds of evidence.',
  },
  {
    title: 'Leave gaps visible',
    text: 'Unknown traction, conflicting claims, and missing proof remain explicit.',
  },
];
---

<BaseLayout
  title="Method"
  description="How Idea turns public builder conversations into concise, source-linked reports."
>
  <header class="page-header shell">
    <p class="chip">Method</p>
    <h1>How reports are made</h1>
    <p>Reports preserve useful details while keeping claims close to their sources.</p>
  </header>

  <div class="method-content shell">
    <section aria-labelledby="method-steps-title">
      <h2 id="method-steps-title">Process</h2>
      <ol class="method-steps">
        {steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="principles-title">
      <h2 id="principles-title">Editorial rules</h2>
      <div class="principle-list">
        {principles.map((principle) => (
          <article>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </section>

    <aside class="method-note">
      <h2>Limits</h2>
      <p>
        Community posts are self-selected and outcomes are often self-reported. These reports help
        identify questions worth testing; they do not replace customer research or market proof.
      </p>
    </aside>

    <a class="text-link" href={withBase('/reports/')}>Browse reports →</a>
  </div>
</BaseLayout>
