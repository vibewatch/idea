---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportCard from '../components/ReportCard.astro';
import { getReportMeta, sortReports } from '../lib/reports';
import { withBase } from '../lib/paths';

const reports = sortReports(await getCollection('reports'));
const latest = reports[0];
const latestMeta = latest ? getReportMeta(latest) : null;
---

<BaseLayout description="Concise, source-linked reports on builder problems, products, and outcomes.">
  <header class="home-intro shell">
    <h1>Builder intelligence, with sources.</h1>
    <p>
      Concise reports on real problems, products, and outcomes. Each finding stays linked to
      its source.
    </p>
    <div class="home-actions">
      {latestMeta && (
        <a class="button button--primary" href={withBase(`/reports/${latestMeta.date}/`)}>
          Read the latest report
        </a>
      )}
      <a class="text-link" href={withBase('/about/')}>How reports are made</a>
    </div>
  </header>

  <section class="home-latest shell" aria-labelledby="latest-report-title">
    <div class="section-title">
      <h2 id="latest-report-title">Latest report</h2>
      <a href={withBase('/reports/')}>All reports</a>
    </div>
    {latestMeta ? (
      <div class="report-list">
        <ReportCard meta={latestMeta} />
      </div>
    ) : (
      <div class="empty-panel"><p>No reports have been published yet.</p></div>
    )}
  </section>
</BaseLayout>
